{
  "name": "@eternalheart/file-preview-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A modern, feature-rich file preview component library for React, Vue, and Angular - Monorepo",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm dev:prep:react && (pnpm --filter @eternalheart/react-file-preview dev & pnpm --filter @eternalheart/react-file-preview-example dev)",
    "dev:vue": "pnpm dev:prep:vue && (pnpm --filter @eternalheart/vue-file-preview dev & pnpm --filter @eternalheart/vue-file-preview-example dev)",
    "dev:angular": "pnpm dev:prep:angular && (pnpm --filter @eternalheart/angular-file-preview dev & node scripts/wait-angular-fesm.mjs && pnpm --filter @eternalheart/angular-file-preview-example dev)",
    "dev:all": "pnpm dev:prep:all && (pnpm --filter @eternalheart/react-file-preview dev & pnpm --filter @eternalheart/react-file-preview-example dev & pnpm --filter @eternalheart/vue-file-preview dev & pnpm --filter @eternalheart/vue-file-preview-example dev & pnpm --filter @eternalheart/angular-file-preview dev & node scripts/wait-angular-fesm.mjs && pnpm --filter @eternalheart/angular-file-preview-example dev)",
    "dev:docs": "pnpm --filter @eternalheart/react-file-preview-docs dev",
    "kill:dev": "for port in 4800 4801 4802 4803; do lsof -ti :$port | xargs -r kill 2>/dev/null && echo \"已终止端口 $port\" || true; done",
    "dev:prep:react": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/react-file-preview build:esm",
    "dev:prep:vue": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/vue-file-preview build:esm",
    "dev:prep:angular": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/angular-file-preview build:esm",
    "dev:prep:all": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/react-file-preview build:esm && pnpm --filter @eternalheart/vue-file-preview build:esm && pnpm --filter @eternalheart/angular-file-preview build:esm",
    "build": "pnpm build:lib && pnpm --filter @eternalheart/react-file-preview-example build && pnpm --filter @eternalheart/vue-file-preview-example build && pnpm --filter @eternalheart/angular-file-preview-example build && pnpm --filter @eternalheart/react-file-preview-docs build",
    "build:lib": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/react-file-preview build && pnpm --filter @eternalheart/vue-file-preview build && pnpm --filter @eternalheart/angular-file-preview build",
    "build:lib:react": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/react-file-preview build",
    "build:lib:vue": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/vue-file-preview build",
    "build:lib:angular": "pnpm --filter @eternalheart/file-preview-core build && pnpm --filter @eternalheart/angular-file-preview build",
    "build:example": "pnpm build:lib:react && pnpm --filter @eternalheart/react-file-preview-example build",
    "build:example:vue": "pnpm build:lib:vue && pnpm --filter @eternalheart/vue-file-preview-example build",
    "build:example:angular": "pnpm build:lib:angular && pnpm --filter @eternalheart/angular-file-preview-example build",
    "build:docs": "pnpm --filter @eternalheart/react-file-preview-docs build",
    "preview:example": "pnpm --filter @eternalheart/react-file-preview-example preview",
    "preview:example:vue": "pnpm --filter @eternalheart/vue-file-preview-example preview",
    "preview:example:angular": "pnpm --filter @eternalheart/angular-file-preview-example preview",
    "preview:docs": "pnpm --filter @eternalheart/react-file-preview-docs preview",
    "clean": "find packages -type d \\( -name dist -o -name lib -o -name .vitepress/dist \\) -prune -exec rm -rf {} + && find packages -type d -name node_modules -prune -exec rm -rf {} + && rm -rf node_modules dist-deploy",
    "lint": "eslint packages --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm --filter @eternalheart/file-preview-core build && node --test tests/unit/*.test.mjs tests/contracts/*.test.mjs",
    "test:unit": "pnpm --filter @eternalheart/file-preview-core build && node --test tests/unit/*.test.mjs",
    "test:contracts": "pnpm --filter @eternalheart/file-preview-core build && node --test tests/contracts/*.test.mjs",
    "gh": "bash scripts/deploy.sh",
    "version:patch:react": "pnpm --filter @eternalheart/react-file-preview version:patch",
    "version:minor:react": "pnpm --filter @eternalheart/react-file-preview version:minor",
    "version:major:react": "pnpm --filter @eternalheart/react-file-preview version:major",
    "pub:react": "pnpm --filter @eternalheart/react-file-preview pub",
    "pub:patch:react": "pnpm version:patch:react && pnpm pub:react",
    "pub:minor:react": "pnpm version:minor:react && pnpm pub:react",
    "pub:major:react": "pnpm version:major:react && pnpm pub:react",
    "version:patch:vue": "pnpm --filter @eternalheart/vue-file-preview version:patch",
    "version:minor:vue": "pnpm --filter @eternalheart/vue-file-preview version:minor",
    "version:major:vue": "pnpm --filter @eternalheart/vue-file-preview version:major",
    "pub:vue": "pnpm --filter @eternalheart/vue-file-preview pub",
    "pub:patch:vue": "pnpm version:patch:vue && pnpm pub:vue",
    "pub:minor:vue": "pnpm version:minor:vue && pnpm pub:vue",
    "pub:major:vue": "pnpm version:major:vue && pnpm pub:vue",
    "version:patch:angular": "pnpm --filter @eternalheart/angular-file-preview version:patch",
    "version:minor:angular": "pnpm --filter @eternalheart/angular-file-preview version:minor",
    "version:major:angular": "pnpm --filter @eternalheart/angular-file-preview version:major",
    "pub:angular": "pnpm --filter @eternalheart/angular-file-preview pub",
    "pub:patch:angular": "pnpm version:patch:angular && pnpm pub:angular",
    "pub:minor:angular": "pnpm version:minor:angular && pnpm pub:angular",
    "pub:major:angular": "pnpm version:major:angular && pnpm pub:angular"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh131462/file-preview.git"
  },
  "bugs": {
    "url": "https://github.com/wh131462/file-preview/issues"
  },
  "homepage": "https://wh131462.github.io/file-preview",
  "license": "MIT",
  "author": {
    "name": "EternalHeart",
    "email": "hao131462@qq.com",
    "url": "https://github.com/wh131462"
  },
  "pnpm": {
    "packageExtensions": {
      "@analogjs/vite-plugin-angular": {
        "dependencies": {
          "typescript": "~5.8.3"
        }
      }
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "less": "^4.5.1",
    "typescript": "^5.6.3"
  }
}
