{
  "name": "@eternalheart/angular-file-preview",
  "version": "1.6.5",
  "description": "A modern, feature-rich file preview component for Angular with support for images, videos, audio, PDFs, Office documents (Word, Excel, PowerPoint), Markdown, and code files.",
  "type": "module",
  "module": "./lib/fesm2022/eternalheart-angular-file-preview.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/fesm2022/eternalheart-angular-file-preview.mjs"
      }
    },
    "./style.css": "./lib/index.css"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "angular",
    "file-preview",
    "image-viewer",
    "pdf-viewer",
    "video-player",
    "audio-player",
    "document-viewer",
    "office-viewer",
    "ppt-viewer",
    "pptx-viewer",
    "powerpoint-viewer",
    "word-viewer",
    "excel-viewer",
    "markdown-viewer",
    "code-viewer"
  ],
  "homepage": "https://wh131462.github.io/file-preview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh131462/file-preview.git",
    "directory": "packages/angular-file-preview"
  },
  "bugs": {
    "url": "https://github.com/wh131462/file-preview/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "EternalHeart",
    "email": "hao131462@qq.com",
    "url": "https://github.com/wh131462"
  },
  "scripts": {
    "build:css": "postcss src/index.css -o lib/index.css",
    "build:esm": "node ../../scripts/ng-packagr-angular.mjs && node ../../scripts/bundle-angular-core.mjs && node ../../scripts/patch-angular-lib-types.mjs && pnpm build:css",
    "build": "pnpm --filter @eternalheart/file-preview-core build && pnpm build:esm",
    "dev": "node ../../scripts/ng-packagr-angular.mjs --watch",
    "prepublishOnly": "pnpm build",
    "version": "node ../../scripts/sync-angular-version.mjs",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "pub": "node ../../scripts/check-npm-login.mjs && npm publish --registry https://registry.npmjs.com"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "@angular/platform-browser": ">=19.0.0"
  },
  "dependencies": {
    "@eternalheart/file-preview-core": "workspace:*",
    "@jsquash/avif": "^2.1.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@likecoin/epub-ts": "^0.6.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "ag-psd": "^30.1.1",
    "exceljs": "^4.4.0",
    "foliate-js": "1.0.1",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.16.45",
    "lucide-angular": "^0.511.0",
    "mammoth": "^1.12.1",
    "markdown-it": "^14.1.0",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "6.1.200",
    "pptx-preview": "^1.0.7",
    "shiki": "^1.24.0",
    "three": "^0.170.0",
    "three-dxf-loader": "^5.2.0",
    "utif": "^3.1.0",
    "video.js": "^8.23.4",
    "x-data-spreadsheet": "^1.1.9"
  },
  "devDependencies": {
    "ng-packagr": "^19.2.0",
    "postcss-cli": "^11.0.1",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "1.3.10",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-prefix-selector": "^2.1.1",
    "rxjs": "^7.8.1",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.3"
  }
}
